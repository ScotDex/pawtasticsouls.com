---
import Layout from '../layouts/Layout.astro';
import background from '../assets/background.webp';
---

<Layout>
  <div 
    id="background-layer" 
    class="fixed inset-0 -z-10 w-screen h-screen bg-no-repeat bg-cover bg-center overflow-hidden"
    style={{ backgroundImage: `url(${background.src})` }}
  ></div>
  
  <div id="container" class="relative z-10 h-screen w-full overflow-hidden">
    <main class="h-full flex items-center justify-center bg-transparent">
      <section id="wrapper" class="flex justify-center p-5">
        
        <div 
          id="hero" 
          class="bg-white w-full max-w-75 sm:max-w-125 aspect-square rounded-full flex items-center justify-center shadow-2xl transition-all duration-300"
        >
          <h1 class="text-2xl sm:text-[2.5rem] text-[#111827] text-center p-10 m-0 font-bold leading-tight">
            Pawtasticsouls from Anna coming soon!
          </h1>
        </div>

      </section>
    </main>
  </div>
</Layout>